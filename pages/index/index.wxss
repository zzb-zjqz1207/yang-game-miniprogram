page {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  min-height: 100vh;
}

.game-container {
  padding: 30rpx;
  background: white;
  border-radius: 20rpx;
  margin: 20rpx;
}

.header {
  text-align: center;
  margin-bottom: 30rpx;
}

.title {
  font-size: 40rpx;
  color: #333;
  margin-bottom: 20rpx;
}

.score-board {
  display: flex;
  justify-content: space-around;
  background: #f0f0f0;
  padding: 15rpx 30rpx;
  border-radius: 10rpx;
  font-size: 28rpx;
  color: #555;
}

.card-pool {
  min-height: 500rpx;
  background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
  border-radius: 16rpx;
  padding: 16rpx;
  margin-bottom: 30rpx;
  display: grid;
  grid-template-columns: repeat(8, 1fr);
  gap: 8rpx;
  box-shadow: inset 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
  border: 1rpx solid rgba(0, 0, 0, 0.05);
}

.slot-container {
  background: linear-gradient(135deg, #fff5f5 0%, #fed7d7 100%);
  border-radius: 14rpx;
  padding: 16rpx;
  margin-bottom: 30rpx;
  border: 2rpx solid #feb2b2;
  box-shadow: 0 2rpx 8rpx rgba(254, 180, 180, 0.3);
}

.slot {
  display: flex;
  justify-content: center;
  gap: 15rpx;
  min-height: 100rpx;
  flex-wrap: wrap;
}

.card {
  width: 100%;
  aspect-ratio: 4/5;
  background: linear-gradient(145deg, #ffffff 0%, #f7f7f7 100%);
  border: 2rpx solid #e2e8f0;
  border-radius: 12rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  font-size: 44rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.08), 0 1rpx 2rpx rgba(0, 0, 0, 0.05);
  position: relative;
  overflow: hidden;
}

.slot-card {
  width: 48rpx;
  height: 58rpx;
  font-size: 36rpx;
  border-radius: 10rpx;
}

.tools {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
  margin-bottom: 30rpx;
}

.tool-btn {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: white;
  padding: 14rpx 16rpx;
  border-radius: 12rpx;
  font-size: 24rpx;
  font-weight: 600;
  position: relative;
  box-shadow: 0 4rpx 12rpx rgba(102, 126, 234, 0.3);
}

.tool-btn .count {
  position: absolute;
  top: -10rpx;
  right: -10rpx;
  background: #ff6b6b;
  color: white;
  border-radius: 50%;
  width: 36rpx;
  height: 36rpx;
  font-size: 22rpx;
  display: flex;
  justify-content: center;
  align-items: center;
}

.controls {
  text-align: center;
}

.action-btn {
  background: linear-gradient(135deg, #48bb78 0%, #38a169 100%);
  color: white;
  border: none;
  padding: 14rpx 48rpx;
  border-radius: 14rpx;
  font-size: 28rpx;
  font-weight: 600;
  box-shadow: 0 4rpx 14rpx rgba(72, 187, 120, 0.35);
}

.modal {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  justify-content: center;
  align-items: center;
  z-index: 1000;
}

.modal-content {
  background: white;
  padding: 60rpx;
  border-radius: 20rpx;
  text-align: center;
  width: 80%;
}

.modal-title {
  font-size: 40rpx;
  color: #333;
  margin-bottom: 20rpx;
  display: block;
}

.modal-message {
  font-size: 30rpx;
  color: #666;
  margin-bottom: 40rpx;
  display: block;
}
