page {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  min-height: 100vh;
}

.game-container {
  padding: 30rpx;
  background: white;
  border-radius: 20rpx;
  margin: 20rpx;
}

.header {
  text-align: center;
  margin-bottom: 30rpx;
}

.title {
  font-size: 40rpx;
  color: #333;
  margin-bottom: 20rpx;
}

.score-board {
  display: flex;
  justify-content: space-around;
  background: #f0f0f0;
  padding: 15rpx 30rpx;
  border-radius: 10rpx;
  font-size: 28rpx;
  color: #555;
}

.card-pool {
  min-height: 400rpx;
  background: #f8f9fa;
  border-radius: 15rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  align-items: center;
  gap: 10rpx;
  position: relative;
}

.slot-container {
  background: #e9ecef;
  border-radius: 10rpx;
  padding: 20rpx;
  margin-bottom: 30rpx;
}

.slot {
  display: flex;
  justify-content: center;
  gap: 15rpx;
  min-height: 100rpx;
  flex-wrap: wrap;
}

.card {
  width: 90rpx;
  height: 110rpx;
  background: linear-gradient(145deg, #ffffff, #e6e6e6);
  border: 2rpx solid #ddd;
  border-radius: 10rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  font-size: 50rpx;
  box-shadow: 0 4rpx 8rpx rgba(0, 0, 0, 0.1);
}

.slot-card {
  width: 75rpx;
  height: 90rpx;
  font-size: 40rpx;
}

.tools {
  display: flex;
  justify-content: space-around;
  margin-bottom: 30rpx;
}

.tool-btn {
  background: linear-gradient(145deg, #667eea, #764ba2);
  color: white;
  padding: 20rpx 30rpx;
  border-radius: 10rpx;
  font-size: 26rpx;
  position: relative;
}

.tool-btn .count {
  position: absolute;
  top: -10rpx;
  right: -10rpx;
  background: #ff6b6b;
  color: white;
  border-radius: 50%;
  width: 36rpx;
  height: 36rpx;
  font-size: 22rpx;
  display: flex;
  justify-content: center;
  align-items: center;
}

.controls {
  text-align: center;
}

.action-btn {
  background: linear-gradient(145deg, #51cf66, #37b24d);
  color: white;
  border: none;
  padding: 25rpx 60rpx;
  border-radius: 10rpx;
  font-size: 30rpx;
}

.modal {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  justify-content: center;
  align-items: center;
  z-index: 1000;
}

.modal-content {
  background: white;
  padding: 60rpx;
  border-radius: 20rpx;
  text-align: center;
  width: 80%;
}

.modal-title {
  font-size: 40rpx;
  color: #333;
  margin-bottom: 20rpx;
  display: block;
}

.modal-message {
  font-size: 30rpx;
  color: #666;
  margin-bottom: 40rpx;
  display: block;
}
